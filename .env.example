# Copiá este archivo como ".env" (sin ".example") y completá tus datos reales.
# El archivo ".env" NUNCA se sube a git (ver .gitignore) porque tiene credenciales.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stock_db
DB_USER=root
DB_PASSWORD=

# Clave secreta para firmar las cookies de sesión. Poné cualquier texto largo
# y aleatorio propio (no uses este de ejemplo en producción).
SESSION_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-1234567890

# Puerto en el que va a escuchar el servidor Node (solo en local)
PORT=3000

# Planillas de Google y cada cuánto se vuelven a leer (segundos).
# GOOGLE_SHEET_ID es STOCK 2026. GOOGLE_SHEET_MAC_ID es la base de MAC.
GOOGLE_SHEET_ID=
# JSON de una cuenta de Google con permiso de editor sobre STOCK 2026.
# Si está vacío, Registrar Movimiento guarda en MySQL y la sync no lo borra.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_MAC_ID=1fNSvCBnYOqBd-IwC6lAdQw6cepZbsAIg8lHj2uGgloU
GOOGLE_SHEET_SOPORTE_ID=1b6zpjoQjgn6bkx6zCBZKgWDAjZ0cWG0x4OPEXJVvNHQ
GOOGLE_SHEET_TESTEO_ID=16Ag2IJwMRHQSkrRIO8pC9ea4dxcSab6EC3TGKg0XmTI
SYNC_INTERVAL_SEC=300

# Correo del conteo de stock. En Gmail usá una contraseña de aplicación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Secreto para el envío automático del último día del mes.
CRON_SECRET=

# En Vercel, DB_HOST tiene que ser un MySQL accesible por internet
# (por ejemplo Aiven). 127.0.0.1 solo funciona en tu PC.
# Para Aiven, pegá el certificado CA en una sola línea, con \n entre líneas:
# DB_SSL=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
