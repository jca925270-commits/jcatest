# Copiá este archivo como ".env" (sin ".example") y completá tus datos reales.
# El archivo ".env" NUNCA se sube a git (ver .gitignore) porque tiene credenciales.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stock_db
DB_USER=root
DB_PASSWORD=

# Clave secreta para firmar las cookies de sesión. Poné cualquier texto largo
# y aleatorio propio (no uses este de ejemplo en producción).
SESSION_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-1234567890

# Puerto en el que va a escuchar el servidor Node (solo en local)
PORT=3000

# En Vercel, DB_HOST tiene que ser un MySQL accesible por internet
# (por ejemplo Aiven). 127.0.0.1 solo funciona en tu PC.
# Para Aiven, pegá el certificado CA en una sola línea, con \n entre líneas:
# DB_SSL=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
